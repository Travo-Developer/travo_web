# The site's public URL, without a trailing slash.
# Used for canonical tags, Open Graph URLs, sitemap.xml, robots.txt and
# structured data. IMPORTANT: set this to the real domain before going live —
# it defaults to https://travo.in, and a wrong value here makes Google index
# the wrong URLs.
NEXT_PUBLIC_SITE_URL=https://travo.in

# Resend — powers the contact form.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered.
CONTACT_TO_EMAIL=travo.info365@gmail.com

# The "from" address. Must be on a domain you have verified in Resend
# (https://resend.com/domains). Until a domain is verified you can use
# Resend's shared sender below, but it will ONLY deliver to the email
# address that owns the Resend account.
CONTACT_FROM_EMAIL="Travo <onboarding@resend.dev>"
